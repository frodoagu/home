{#- Daily curves for the lamps (luces_bano, luces_llave, luces_salon). Times are
    minutes since noon, so the night is one stretch: 21:00 is 540, 23:30 is
    690, 02:00 is 840. Import with
    {% from 'curva.jinja' import curva, sol, minutos %}
    Macros return text: pipe the result through `| int` or `| float`. -#}

{%- macro minutos(t) -%}
{{ (t.hour * 60 + t.minute - 720) % 1440 }}
{%- endmacro -%}

{#- A sun.sun time (`next_rising`, `next_setting`) plus `extra` minutes. It is
    today's or tomorrow's, a minute or two apart, so only its time of day is
    used. -#}
{%- macro sol(attr, extra=0) -%}
{%- set t = state_attr('sun.sun', attr) | as_datetime | as_local -%}
{{ (t.hour * 60 + t.minute + extra - 720) % 1440 }}
{%- endmacro -%}

{#- Column `col` of curve `p` at minute `m` (now by default): rows are
    [minute, value, ...] in ascending minutes, joined by straight lines; before
    the first row it holds the first, after the last it holds the last. Pass
    `m` when reading several columns, so they all come from the same minute. -#}
{%- macro curva(p, col=1, m=none) -%}
{%- set m = m if m is not none else minutos(now()) | int -%}
{%- set ns = namespace(a=p[0], b=p[0], f=0) -%}
{%- for i in range(p | count - 1) if p[i][0] <= m -%}
{%- set ns.a = p[i] -%}
{%- set ns.b = p[i + 1] -%}
{%- set ns.f = [(m - ns.a[0]) / (ns.b[0] - ns.a[0]) if ns.b[0] > ns.a[0] else 1, 1] | min -%}
{%- endfor -%}
{{ ns.a[col] + (ns.b[col] - ns.a[col]) * ns.f }}
{%- endmacro -%}
